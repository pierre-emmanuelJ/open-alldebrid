{
  "name": "open-alldebrid",
  "version": "1.0.0",
  "description": "Typed client for the AllDebrid API, built from the open-alldebrid OpenAPI spec",
  "license": "MIT",
  "author": "Pierre-Emmanuel Jacquier",
  "homepage": "https://github.com/pierre-emmanuelJ/open-alldebrid/tree/master/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierre-emmanuelJ/open-alldebrid.git",
    "directory": "sdks/typescript"
  },
  "bugs": "https://github.com/pierre-emmanuelJ/open-alldebrid/issues",
  "keywords": ["alldebrid", "debrid", "magnet", "torrent", "openapi", "sdk"],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.yaml --output src/schema.gen.ts --enum-values",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.4",
    "openapi-typescript": "7.13.0",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
